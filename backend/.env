# =============================================================================
# Ai-Notez Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Backend Configuration (for server-side Firebase Admin)
# Required for: User authentication verification, database access
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Path to Firebase Admin SDK service account JSON file
# Store this file OUTSIDE the repository and reference its path here
# Example: GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Firebase Client Configuration (for serving to frontend)
# Required for: Frontend Firebase initialization
# These values are served via /v1/firebase-config endpoint
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# AI Provider Configuration
# Required for: AI features (chat, summaries, embeddings, search)
# -----------------------------------------------------------------------------

# Gemini (Google) - https://aistudio.google.com/apikey
AI_GEMINI_API_KEY=your-gemini-api-key

# Groq - https://console.groq.com/keys
AI_GROQ_API_KEY=your-groq-api-key

# Optional: Separate embedding API key (falls back to Gemini if not set)
AI_EMBEDDING_API_KEY=your-embedding-api-key

# Embedding configuration
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# CORS Origins (comma-separated, no trailing slashes)
# Example: NOTEZ_CORS_ORIGINS=https://ai-notez.web.app,http://localhost:8000
NOTEZ_CORS_ORIGINS=https://your-frontend.web.app,http://localhost:8000

# Data directory for USearch indexes and SQLite database
# Default: ./data (relative to backend directory)
NOTEZ_DATA_DIR=./data

# Default AI provider (gemini or groq)
AI_DEFAULT_PROVIDER=gemini

# AI Model configurations
# Available models for each provider (comma-separated)
AI_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3-flash-preview
AI_GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# Rate Limiting & Request Configuration
# -----------------------------------------------------------------------------

# Maximum prompt characters allowed
AI_MAX_PROMPT_CHARS=60000

# Request timeout in seconds
AI_REQUEST_TIMEOUT_SECONDS=60

# Rate limit: max requests per user per window
# Default: 30 requests per 60 seconds
# Set to 0 to disable rate limiting
AI_RATE_LIMIT=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Vector Search Configuration
# -----------------------------------------------------------------------------

# Maximum chunks per user
AI_MAX_CHUNKS_PER_USER=20000

# Maximum indexed notes per user
AI_MAX_INDEXED_NOTES=5000

# Maximum search results to return
AI_MAX_SEARCH_RESULTS=8

# Minimum similarity score for search results (0.0 to 1.0)
AI_MIN_SIMILARITY=0.18

# Chunking configuration
# Note: These are hardcoded in vector_store.py but can be referenced here
# CHUNK_SIZE=1600
# CHUNK_OVERLAP=200
# EMBED_BATCH_SIZE=64
