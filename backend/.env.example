# Copy to .env in the backend directory. Never commit real credentials.
# Firebase project / web client configuration
FIREBASE_PROJECT_ID=ai-notez
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=ai-notez.firebaseapp.com
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Server-side Firebase service account JSON.
# Supply the JSON as a single-line environment value when required by your host.
FIREBASE_SERVICE_ACCOUNT_JSON=

# AI generation providers. Configure at least one provider key.
AI_DEFAULT_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_GROQ_API_KEY=
AI_MISTRAL_API_KEY=
AI_MISTRAL_ENABLED=false
AI_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
AI_GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,llama-3.1-8b-instant
AI_MISTRAL_MODELS=mistral-large-latest,mistral-small-latest

# Embeddings / semantic search. Set credentials for the selected provider.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_GROQ_EMBEDDING_MODEL=text-embedding-3-small

# Backend runtime and retrieval limits
NOTEZ_DATA_DIR=./data
NOTEZ_CORS_ORIGINS=http://localhost:8000,https://ai-notez.web.app
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_PROMPT_CHARS=60000
AI_MAX_CHUNKS_PER_USER=20000
AI_MAX_INDEXED_NOTES=5000
AI_MAX_SEARCH_RESULTS=8
AI_MIN_SIMILARITY=0.18
# Notes refreshed per chat request; larger libraries finish over several turns.
AI_RAG_MAX_INDEX_UPDATES=24
